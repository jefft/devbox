# MySQL configuration file for Devbox MariaDB
#
# This file is read via --defaults-file, which means ONLY this config file
# is read (system configs in /etc/ are skipped).
#
# Runtime paths (datadir, socket, pid-file, basedir) are set by the wrapper
# script via environment variables and cannot be overridden here:
#
#   MYSQL_DATADIR  = --datadir   (default: .devbox/data/mariadb)
#   MYSQL_UNIX_PORT = --socket   (default: {{ .RuntimeDir }}/mysql.sock, a
#                                 short per-user runtime path outside the
#                                 project, under $XDG_RUNTIME_DIR or the temp
#                                 dir, keyed by a hash of the project dir)
#   MYSQL_PID_FILE = --pid-file  (default: {{ .RuntimeDir }}/mysql.pid)

[mariadbd]

# Socket-only by default: the server does not listen on TCP at all
# (skip-networking). A system MySQL/MariaDB often already owns 127.0.0.1:3306,
# which would crash-loop this server with "Address already in use". Everything
# here connects via the unix socket instead: the wrapped mariadb/mariadb-admin
# clients (below) and any app using $MYSQL_UNIX_PORT. To serve TCP anyway,
# comment out skip-networking and set:
# port = 3306
skip-networking

[client]
protocol = socket
# Set client defaults here, e.g.:
#
# user = myapp
# password = s3cret


[client-admin]
# This section is used by mariadb-admin
protocol = socket
user = root
# If you change the root password ('mariadb-admin password'), set the new one here:
password =
