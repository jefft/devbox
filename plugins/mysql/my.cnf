# MySQL configuration file for Devbox MySQL
#
# This file is read via --defaults-file, which means ONLY this config file
# is read (system configs in /etc/ are skipped).
#
# Runtime paths (datadir, socket, pid-file, basedir) are set by the wrapper
# script via environment variables and cannot be overridden here:
#
#   MYSQL_DATADIR  = --datadir   (default: .devbox/data/mysql)
#   MYSQL_UNIX_PORT = --socket   (default: {{ .RuntimeDir }}/mysql.sock, a
#                                 short per-user runtime path outside the
#                                 project, under $XDG_RUNTIME_DIR or the temp
#                                 dir, keyed by a hash of the project dir)
#   MYSQL_PID_FILE = --pid-file  (default: {{ .RuntimeDir }}/mysql.pid)

[mysqld]
# Uncomment to disable binary logging.
# skip-log-bin
#
# The TCP/IP port the server listens on.
# Change this if 3306 is already in use.
#port = 3306

# If your app connects via $MYSQL_UNIX_PORT (the unix socket), you can skip
# networking entirely by uncommenting this line:
# skip-networking

[client]
# Set client defaults here, e.g.:
#
# protocol = socket
# user = myapp
# password = s3cret


[client-admin]
# This section is used by mysqladmin
protocol = socket
user = root
# If you change the root password ('mysqladmin password'), set the new one here:
password =
