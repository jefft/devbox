{
    "name": "postgresql",
    "version": "0.0.4",
    "description": "To initialize the database run `initdb`.",
    "packages": {
        "glibcLocales": {
            "version": "latest",
            "platforms": ["x86_64-linux", "aarch64-linux"]
        }
    },
    "env": {
        "PGDATA": "{{ .DataDir }}",
        "PGHOST": "{{ .RuntimeDir }}"
    },
    "create_files": {
        "{{ .DataDir }}": "",
        "{{ .RuntimeDir }}": "",
        "{{ .Virtenv }}/process-compose.yaml": "postgresql/process-compose.yaml",
        "{{ .Virtenv }}/setup_db.sh": "postgresql/setup_db.sh"
    },
    "shell": {
        "init_hook": [
            "bash \"{{ .Virtenv }}/setup_db.sh\""
        ]
    }
}
